{
    "name": "spora-ai/spora-plugin-muse",
    "description": "Meta Muse vendor home for Spora agents — speech-to-text (Muse Voice Transcribe) + image generation (Muse Image) today; future Muse Spark text, Muse Glimmer TTS, etc.",
    "type": "spora-plugin",
    "keywords": ["spora-plugin", "spora", "meta", "muse", "image-generation", "speech-to-text"],
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "spora-ai/spora-core": "^0.24.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/process": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "justinrainbow/json-schema": "^6.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Spora\\Plugins\\Muse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spora\\Plugins\\Muse\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:parallel": "pest --parallel --processes=auto --max-batch-size=50",
        "analyse": "phpstan analyse --no-progress --memory-limit=2G",
        "lint": "php-cs-fixer fix --dry-run --diff --no-interaction"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "spora-ai/installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
